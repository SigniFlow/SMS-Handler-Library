<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <PackageId>SigniFlow.SMSHandler</PackageId>
        <Version>2.0.0</Version>
        <PackageVersion>$(Version)</PackageVersion>
        <PackageReleaseNotes>Added an optional JSON SMS event endpoint and the optional string field OtpValue for both JSON and form requests. Breaking change: clients must rename the request field BussinessID to BusinessID.</PackageReleaseNotes>
        <RepositoryUrl>https://github.com/SigniFlow/SMS-Handler-Library</RepositoryUrl>
        <Authors>SigniFlow</Authors>
        <PackageProjectUrl>https://signiflow.com</PackageProjectUrl>
        <Copyright>Copyright (c) SigniFlow 2025-2026</Copyright>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.*"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

</Project>
